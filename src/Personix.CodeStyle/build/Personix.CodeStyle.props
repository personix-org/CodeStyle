<Project>

  <PropertyGroup>
    <!-- Without this, IDE* rules are reported by the IDE only and never fail a build or CI run. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- PERSONIX005 and PERSONIX006 skip externally visible members of packable projects. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="IsPackable" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)Personix.CodeStyle.globalconfig" />
  </ItemGroup>

</Project>
