# Personix shared code style — distributed via the Personix.CodeStyle package.
#
# This is a *global* AnalyzerConfig: it applies to every file in the consuming project without
# living on disk in that repository. A repository-local .editorconfig still wins over it, which is
# deliberate — a project can opt out of a specific rule when it has a reason to.
is_global = true
global_level = 100

# --- Braces -----------------------------------------------------------------
# Every control-flow statement gets a block, including single-line ones. Raised to error so that
# an unbraced if fails the build rather than being underlined in the editor and merged anyway.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = error

# --- Expression bodies ------------------------------------------------------
# Block bodies for methods, and this rule is about what the IDE writes rather than about what is
# already written. On `true`, asking it to implement an interface or base member produces an
# expression body on a method that is about to be given several statements, and every generated
# member has to be unwrapped by hand before it can be filled in.
#
# Silent on purpose, so it governs generation and nothing else. Which of the two forms reads better
# is a judgement per method, and a visible severity would underline every expression-bodied method
# in a repository that has settled on them — with code cleanup on save rewriting them wholesale.
csharp_style_expression_bodied_methods = false
dotnet_diagnostic.IDE0022.severity = silent

# --- Namespaces -------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Folders are allowed to group files without forcing a matching namespace. Splitting types into
# subfolders is an organisational choice — pushing every folder into the namespace would make
# consumers write several usings for what is one coherent API surface.
dotnet_diagnostic.IDE0130.severity = none

# --- Unused code ------------------------------------------------------------
# Unused usings and unread private members are noise that hides real problems.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# --- Correctness ------------------------------------------------------------
# Empty catch blocks and unused parameters are usually a mistake rather than intent.
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.IDE0060.severity = suggestion

# --- Naming -----------------------------------------------------------------
# Private instance fields carry an underscore, so a bare name in a method body is a local and a
# prefixed one is state. Nothing enforced this before, and the convention was held by hand until it
# was not — an underscore dropped during a rename reads as perfectly ordinary code.
#
# Three rules, and the order matters: the first match wins, so the two narrow ones have to come
# before the general one, or it would claim every private field before they are reached.
dotnet_diagnostic.IDE1006.severity = warning

# A private const is a constant and reads like one. The underscore would say "instance state", which
# is the opposite of what it is.
dotnet_naming_rule.private_const_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_const_fields_are_pascal_case.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

# Private static readonly fields are constants in all but the keyword, so they follow the same shape.
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Everything else private gets the underscore.
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
