<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The repository follows the rules it ships, read straight from the source file. -->
  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)src/Personix.CodeStyle/build/Personix.CodeStyle.globalconfig" />
  </ItemGroup>
</Project>
